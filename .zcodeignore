# ---- 运行时与构建产物（规则：绝不提交 generated runtime directories）----
runs/
run/
logs/
*.log
# 变更日志是文档而非运行时日志，必须入库（DEVELOPMENT.md §2.3）
!change.log
out/
build/
dist/
dist-ssr/
coverage/
*.tsbuildinfo

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.hatch/

# ---- Node / 前端 ----
node_modules/
.vite/
*.local

# ---- 密钥与本地配置（规则：绝不 stage credentials）----
.env
.env.*
*.pem
*.key
config.local.toml
secrets/

# ---- 编辑器与系统 ----
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ---- 临时 worktree 目录（若放在仓库内）----
.worktrees/

# ---- 运行时安装的插件目录（管理平台安装目标，ARCHITECTURE §8 v1.1）----
/plugins/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
site-packages/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
